---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Icon from '../components/Icon.astro';
import { SPONSORS_URL } from '../lib/site';
---
<Base title="تذكرتي · عيد الـ74 للمجموعة الحادية عشر" noindex bodyClass="tk-page">
  <div class="tk-wrap">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <a class="back-link" href="/"><Icon name="arrow-prev" size={16} /><T ar="صفحة الدعوة" en="Invitation" /></a>
      <button class="lang-toggle" type="button" data-lang-toggle><span class="ar" lang="en">EN</span><span class="en">عربي</span></button>
    </div>

    <article class="ticket" id="ticket" aria-live="polite">
      <header class="ticket__top">
        <div>
          <p><T ar="المجموعة الحادية عشر" en="XI Group" /></p>
          <h1><T ar="تذكرة عيد الـ74" en="74th anniversary ticket" /></h1>
        </div>
        <span class="ticket__74" aria-hidden="true">74</span>
      </header>

      <!-- loading -->
      <div class="state" data-view="loading">
        <div class="spinner" style="border-color:var(--line);border-top-color:var(--gold)" aria-hidden="true"></div>
        <p><T ar="جاري تحميل تذكرتك…" en="Loading your ticket…" /></p>
      </div>

      <!-- verified -->
      <div data-view="verified" hidden>
        <div class="ticket__body">
          <p class="approved" data-f="approved" hidden role="status"><Icon name="check-circle" size={20} /><span><T ar="تم قبول حجزك! هذه تذكرتك." en="Your booking was approved! Here is your ticket." /></span></p>
          <span class="chip chip--ok" id="tk-chip"><T ar="صالحة للدخول" en="Valid for entry" /></span>
          <div class="qr-frame" id="qr-frame">
            <canvas id="qr" width="260" height="260" role="img" aria-label="QR"></canvas>
            <div class="stamp" id="used-stamp" hidden><span><T ar="تم الدخول" en="Checked in" /></span></div>
          </div>
          <p class="tk-name" data-f="name"></p>
          <p class="tk-code" data-f="code"></p>
          <p class="fine"><T ar="قدّم رمز QR على البوابة. التذكرة تُستخدم مرة واحدة فقط، فلا تشاركها." en="Show this QR at the gate. It works once only, so don’t share it." /></p>
        </div>
        <div class="perf" aria-hidden="true"></div>
        <ul class="tk-info" role="list">
          <li><Icon name="calendar" size={18} /><span><small><T ar="الموعد" en="When" /></small><span data-f="when"><T ar="يُعلن قريباً" en="To be announced" /></span></span></li>
          <li><Icon name="pin" size={18} /><span><small><T ar="المكان" en="Where" /></small><span data-f="where"><T ar="يُعلن قريباً" en="To be announced" /></span></span></li>
          <li><Icon name="ticket" size={18} /><span><small><T ar="صاحب التذكرة" en="Ticket holder" /></small><span data-f="holder"></span></span></li>
        </ul>
      </div>

      <!-- review -->
      <div class="state review" data-view="review" hidden>
        <p class="review__banner" role="status">
          <Icon name="hourglass" size={20} />
          <span><T ar="حجزك قيد المراجعة ولم يُقبل بعد" en="Your booking is under review and not accepted yet" /></span>
        </p>
        <p class="review__fresh" data-f="fresh" hidden><T ar="تم استلام طلبك وصورة الإيصال بنجاح." en="We received your booking and your screenshot." /></p>
        <ol class="track" aria-label="حالة الحجز">
          <li class="is-done"><span class="track__dot"><Icon name="check" size={16} /></span><span><strong><T ar="استلمنا الإيصال" en="Receipt received" /></strong></span></li>
          <li class="is-now"><span class="track__dot"><Icon name="hourglass" size={14} /></span><span><strong><T ar="مراجعة المنظمين" en="Organisers review it" /></strong><small><T ar="نحن هنا الآن" en="You are here" /></small></span></li>
          <li><span class="track__dot">3</span><span><strong><T ar="تذكرتك برمز QR" en="Your QR ticket" /></strong><small><T ar="تظهر في هذه الصفحة بعد الموافقة" en="Appears on this page once approved" /></small></span></li>
        </ol>
        <div class="notice notice--warn review__note">
          <Icon name="alert" size={18} />
          <span><T ar="هذه ليست تذكرة دخول بعد. لا يمكنك الدخول بها حتى يوافق المنظمون على التحويل وتظهر لك تذكرة برمز QR." en="This is not an entry ticket yet. It won’t get you in until the organisers approve your transfer and a QR ticket appears here." /></span>
        </div>
        <div class="review__why" data-f="why" hidden>
          <p class="review__why-title"><T ar="لماذا يحتاج إيصالك إلى مراجعة؟" en="Why does your receipt need a review?" /></p>
          <ul class="reasons reasons--warn" data-f="reasons"></ul>
        </div>
        <p class="review__live"><span class="live-dot" aria-hidden="true"></span><span data-f="checked"></span></p>
        <p class="tk-code" data-f="code"></p>
        <div class="review__actions">
          <button class="btn btn--sm" type="button" data-notify hidden><Icon name="check-circle" size={16} /><T ar="نبّهني عند القبول" en="Alert me when approved" /></button>
          <button class="btn btn--ghost btn--sm" type="button" data-copy-link><Icon name="link" size={16} /><T ar="نسخ رابط الصفحة" en="Copy page link" /></button>
          <a class="btn btn--ghost btn--sm" data-contact href="https://www.facebook.com/XI.SGWEN" target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /><T ar="تواصل مع المنظمين" en="Contact the organisers" /></a>
        </div>
        <p class="fine"><T ar="احفظ رابط هذه الصفحة: هو مكان تذكرتك. يمكنك أيضاً العودة إليها من «تذاكرك على هذا الجهاز» في صفحة الدعوة." en="Keep this page’s link: it is where your ticket will be. You can also come back from “Your tickets on this device” on the invitation page." /></p>
      </div>

      <!-- rejected -->
      <div class="state" data-view="rejected" hidden>
        <span class="state__icon" style="background:var(--bad-soft);color:var(--bad)"><Icon name="x-circle" size={32} /></span>
        <h2><T ar="لم نتمكن من قبول هذا الإيصال" en="We couldn’t accept this receipt" /></h2>
        <ul class="reasons" data-f="reasons"></ul>
        <p><T ar="إذا كنت حوّلت المبلغ الصحيح إلى حساب المجموعة، أعد المحاولة بصورة أوضح لشاشة نجاح التحويل، أو تواصل مع المنظمين ومعك الرقم التالي." en="If you sent the right amount to the group’s account, try again with a clearer screenshot of the success screen, or contact the organisers with the code below." /></p>
        <p class="tk-code" data-f="code"></p>
        <a class="btn btn--sm" href="/#ticket"><T ar="إعادة المحاولة" en="Try again" /></a>
      </div>

      <!-- not found -->
      <div class="state" data-view="missing" hidden>
        <span class="state__icon" style="background:var(--bad-soft);color:var(--bad)"><Icon name="alert" size={32} /></span>
        <h2><T ar="لم نجد هذه التذكرة" en="Ticket not found" /></h2>
        <p><T ar="تأكد من الرابط كاملاً، أو احجز تذكرة من صفحة الدعوة." en="Check the full link, or get a ticket from the invitation page." /></p>
        <a class="btn btn--sm" href="/#ticket"><T ar="صفحة الحجز" en="Booking page" /></a>
      </div>

      <!-- network -->
      <div class="state" data-view="offline" hidden>
        <span class="state__icon" style="background:var(--warn-soft);color:var(--warn)"><Icon name="refresh" size={32} /></span>
        <h2><T ar="تعذر الاتصال" en="Could not connect" /></h2>
        <p><T ar="تأكد من اتصالك بالإنترنت ثم أعد المحاولة." en="Check your connection and try again." /></p>
        <button class="btn btn--sm" type="button" data-retry><T ar="إعادة المحاولة" en="Retry" /></button>
      </div>
    </article>

    <div class="tk-actions" id="tk-actions" hidden>
      <button class="btn btn--gold" type="button" id="save-qr"><Icon name="download" size={18} /><T ar="حفظ صورة التذكرة" en="Save ticket image" /></button>
      <button class="btn btn--light" type="button" id="share"><Icon name="share" size={18} /><T ar="مشاركة الرابط" en="Share link" /></button>
      <a class="btn btn--ghost btn--wide" id="cal" href="#" download="xi-74.ics" hidden style="color:#fff"><Icon name="calendar" size={18} /><T ar="أضف إلى التقويم" en="Add to calendar" /></a>
    </div>

    <a class="offer-card" id="offers" href={SPONSORS_URL} hidden>
      <Icon name="gift" size={30} />
      <span><strong><T ar="عروض حصرية لحاملي التذاكر" en="Offers for ticket holders" /></strong><span><T ar="اكتشف عروض رعاة الاحتفال وشركائه" en="See what the festival’s sponsors are offering" /></span></span>
      <Icon name="arrow-next" size={20} />
    </a>
  </div>

  <script>
    import '../scripts/ticket';
  </script>
</Base>

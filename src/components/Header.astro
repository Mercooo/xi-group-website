---
import { sites, UNITS, GROUP_NAME, displayLabel, type NavItem, type SiteKey } from '../lib/data';
import Icon from './Icon.astro';
import Patch from './Patch.astro';

interface Props { siteKey: SiteKey; currentPath: string }
const { siteKey, currentPath } = Astro.props;
const group = sites.group;
const unit = siteKey === 'group' ? null : sites[siteKey];
const unitInfo = UNITS.find((u) => u.key === siteKey);

// Long sub-lists (e.g. 26 songs) are reached through their index page instead of a dropdown.
const MAX_DROPDOWN = 9;
const showChildren = (item: NavItem) => !!item.children?.length && item.children.length <= MAX_DROPDOWN;
const isActive = (item: NavItem, base: string) =>
  !item.external && (item.href === currentPath || (item.href !== base && currentPath.startsWith(item.href + '/')));
const linkAttrs = (item: NavItem) => (item.external ? { target: '_blank', rel: 'noopener' } : {});
const unitOf = (href: string) => UNITS.find((u) => sites[u.key].base === href);
---
<header class="site-header">
  <div class="bar">
    <div class="wrap bar__inner">
      <a class="brand" href="/" aria-label={`${GROUP_NAME} — الصفحة الرئيسية`}>
        {group.logo && <img class="brand__logo" src={group.logo} alt="" width="40" height="40" />}
        <span class="brand__name">{GROUP_NAME}</span>
      </a>

      <nav class="nav" aria-label="القائمة الرئيسية">
        <ul>
          {group.nav.map((item) => (
            <li class:list={{ 'has-menu': showChildren(item) }}>
              <a href={item.href} {...linkAttrs(item)} aria-current={isActive(item, '/') || (item.href === '/' && currentPath === '/') ? 'page' : undefined}>
                {displayLabel(item.label)}
                {item.external && <Icon name="external" size={13} />}
                {showChildren(item) && <Icon name="chevron" size={15} class="chev" />}
              </a>
              {showChildren(item) && (
                <ul class="menu">
                  {item.children!.map((c) => {
                    const u = unitOf(c.href);
                    return (
                      <li data-site={u?.key}>
                        <a href={c.href} {...linkAttrs(c)}>
                          {u && <span class="dot" />}
                          {u ? u.name : displayLabel(c.label)}
                          {u && <small>{u.ages}</small>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="bar__tools">
        <a class="icon-btn" href="/search" aria-label="بحث في الموقع"><Icon name="search" /></a>
        <button class="icon-btn menu-btn" type="button" aria-label="فتح القائمة" aria-controls="drawer" aria-expanded="false" data-menu-open>
          <Icon name="menu" />
        </button>
      </div>
    </div>
  </div>

  {unit && (
    <div class="unitbar">
      <div class="wrap unitbar__inner">
        <a class="unitbar__brand" href={unit.base}>
          <Patch logo={unit.logo} size={34} />
          <span>{unitInfo?.name}</span>
        </a>
        <nav class="unitnav" aria-label={`أقسام ${unitInfo?.name}`}>
          <ul>
            {unit.nav.filter((i) => i.href !== unit.base).map((item) => (
              <li class:list={{ 'has-menu': showChildren(item) }}>
                <a href={item.href} {...linkAttrs(item)} aria-current={isActive(item, unit.base) ? 'page' : undefined}>
                  {displayLabel(item.label)}
                  {showChildren(item) && <Icon name="chevron" size={15} class="chev" />}
                </a>
                {showChildren(item) && (
                  <ul class="menu">
                    {item.children!.map((c) => (
                      <li><a href={c.href} {...linkAttrs(c)}>{displayLabel(c.label)}{c.external && <Icon name="external" size={13} />}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  )}
</header>

<!-- Mobile drawer: the full page tree of the current site, top-level links of the others -->
<div class="drawer" id="drawer" hidden>
  <div class="drawer__backdrop" data-menu-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="القائمة">
    <div class="drawer__head">
      <strong>القائمة</strong>
      <button class="icon-btn" type="button" aria-label="إغلاق القائمة" data-menu-close><Icon name="close" /></button>
    </div>
    <form class="drawer__search" action="/search" role="search">
      <input type="search" name="q" placeholder="ابحث في الموقع" aria-label="بحث في الموقع" />
    </form>
    {(['group', ...UNITS.map((u) => u.key)] as SiteKey[]).map((key) => {
      const s = sites[key];
      const label = key === 'group' ? GROUP_NAME : UNITS.find((u) => u.key === key)!.name;
      const renderTree = (items: NavItem[]): any => (
        <ul>
          {items.map((it) => (
            <li>
              {it.children?.length ? (
                <details open={currentPath === it.href || currentPath.startsWith(it.href + '/') ? true : undefined}>
                  <summary>
                    <a href={it.href}>{displayLabel(it.label)}</a>
                    <Icon name="chevron" size={18} class="chev" />
                  </summary>
                  {renderTree(it.children)}
                </details>
              ) : (
                <a href={it.href} {...linkAttrs(it)} aria-current={it.href === currentPath ? 'page' : undefined}>
                  {displayLabel(it.label)}{it.external && <Icon name="external" size={13} />}
                </a>
              )}
            </li>
          ))}
        </ul>
      );
      return (
        <details class="drawer__site" data-site={key} open={key === siteKey ? true : undefined}>
          <summary>
            {key === 'group' ? (s.logo && <img src={s.logo} alt="" width="30" height="30" loading="lazy" />) : <Patch logo={s.logo} size={30} />}
            <span>{label}</span>
            <Icon name="chevron" size={18} class="chev" />
          </summary>
          {key === siteKey ? renderTree(s.nav) : (
            <ul>
              {s.nav.map((it) => (
                <li><a href={it.href} {...linkAttrs(it)}>{displayLabel(it.label)}{it.external && <Icon name="external" size={13} />}</a></li>
              ))}
            </ul>
          )}
        </details>
      );
    })}
  </div>
</div>

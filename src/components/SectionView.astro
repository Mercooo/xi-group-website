---
import type { Section } from '../lib/data';
import BlockView from './BlockView.astro';

interface Props { section: Section; first?: boolean }
const { section: s } = Astro.props;

// Columns that only hold spacing are kept on wide screens (they centre the
// content like on Google Sites) and dropped on phones.
type Blocks = Section['rows'][0][0]['blocks'];
const isEmpty = (blocks: Blocks) => blocks.every((b) => b.type === 'spacer');
// Narrow columns pair up on tablets; ones holding long text go full width on phones.
const widthClass = (span: number) => (span <= 3 ? 's' : span <= 5 ? 'm' : 'l');
const textLength = (blocks: Blocks) => blocks.reduce((n, b) => n + (b.type === 'text' ? b.html.replace(/<[^>]+>/g, '').length : 0), 0);
---
<section
  class:list={['sec', `sec--${s.style}`, { 'sec--bg': s.bg }]}
  style={s.bg ? `--bg:url('${s.bg}')` : undefined}
>
  <div class="container">
    {s.rows.map((row) => (
      <div class="row">
        {row.map((col) => (
          <div
            class:list={['col', { 'col--empty': isEmpty(col.blocks) }]}
            style={`--span:${col.span}`}
            data-w={widthClass(col.span)}
            data-long={textLength(col.blocks) > 140 ? '' : undefined}
          >
            {col.blocks.map((block) => <BlockView block={block} />)}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
